{
    "name": "ernestdefoe/salvage",
    "description": "Fight link rot: copies hotlinked images in posts to your own storage before their source disappears, and finds dead links across the forum so staff can fix, replace, unlink or point them at an archive.org copy.",
    "keywords": ["flarum", "link rot", "broken links", "dead links", "link checker", "hotlink", "images", "archive.org", "wayback"],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ernestdefoe/salvage/issues",
        "source": "https://github.com/ernestdefoe/salvage"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "fof/upload": "Mirrored images are stored through FoF Upload (its storage, its media manager) when the post's author may upload.",
        "flarum/flags": "Optionally flag posts with broken links for moderators."
    },
    "extra": {
        "flarum-extension": {
            "title": "Salvage",
            "category": "feature",
            "icon": {
                "name": "fas fa-life-ring",
                "backgroundColor": "#0f766e",
                "color": "#ffffff"
            }
        },
        "flarum-cli": {
            "modules": {
                "backendTesting": true,
                "js": true
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Salvage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Salvage\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "flarum/flags": "^2.0",
        "flarum/markdown": "^2.0",
        "flarum/bbcode": "^2.0",
        "flarum/mentions": "^2.0",
        "fof/upload": "^2.0",
        "flarum/tags": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    }
}
